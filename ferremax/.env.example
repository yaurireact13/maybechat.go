APP_NAME=FerreMax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=saas_ferreteria
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

MAIL_MAILER=log

# En producción con HTTPS déjalo en true (por defecto se activa si APP_ENV=production)
# SESSION_SECURE_COOKIE=true

# ===== Facturación electrónica (microservicio facturacion-service) =====
# "simulado" acepta los comprobantes localmente (código -SIM) para probar el flujo;
# "real" llama al microservicio en FACT_BASE_URL.
FACT_ENABLED=true
FACT_MODO=simulado
FACT_BASE_URL=http://localhost:8090
FACT_TOKEN=
FACT_PAIS=PE
FACT_SERIE_FACTURA=F001
FACT_SERIE_BOLETA=B001

# ===== Producción (Hostinger u otro) =====
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tudominio.com
