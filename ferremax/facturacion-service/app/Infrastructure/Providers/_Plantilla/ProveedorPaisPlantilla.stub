/**
 * ============================================================================
 *  PLANTILLA PARA AGREGAR UN NUEVO PAIS  (ej. Colombia / DIAN)
 * ============================================================================
 *
 *  PASOS (sin modificar NINGUN codigo existente del dominio ni de aplicacion):
 *
 *   1. Copia este archivo a:
 *        app/Infrastructure/Providers/Colombia/DianProveedor.php
 *      y renombra la clase a DianProveedor.
 *
 *   2. Implementa la interfaz ProveedorFacturacion traduciendo el modelo de
 *      dominio al formato local (Colombia: UBL 2.1 + CUFE, validacion previa DIAN).
 *
 *   3. Registra el adaptador en config/facturacion.php:
 *        'CO' => \App\Infrastructure\Providers\Colombia\DianProveedor::class,
 *
 *   4. (Opcional) agrega parametros del pais en config('facturacion.pais.CO').
 *
 *   Listo. El ERP ya puede facturar en Colombia enviando "pais": "CO".
 *   El dominio, los casos de uso y el ERP NO se tocan (Principio Abierto/Cerrado).
 * ============================================================================
 */

